# packaging/fetch_tools.py downloads (LilyPond, FFmpeg, the HTDemucs weights)
/.venv/
/tools/
# model weights and datasets downloaded for benchmarks (drum_agent/models_cache.py)
/.cache/
tests/_artifacts/
examples/output/**/*.midi
.claude/worktrees/
# audio is never committed (recordings, downloads, synthesized test audio)
*.[wW][aA][vV]
*.[mM][pP]3
*.[mM]4[aA]
*.[aA][aA][cC]
*.[fF][lL][aA][cC]
*.[oO][gG][gG]
*.[oO][pP][uU][sS]
*.[aA][iI][fF]
*.[aA][iI][fF][fF]
# a filled-in copy of .env.example holds credentials: never committed
.env
.env.*
!.env.example
