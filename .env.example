# Drum Agent web app (python -m drum_agent serve). Copy to .env, fill in what you use,
# and load it into the server's environment (e.g. `set -a; . ./.env; set +a`).
# Every value here stays on the server; the page never receives any of them.

# Where songs, uploaded (normalized) audio, jobs and chart versions are stored.
DRUM_AGENT_DATA_DIR=~/.drum_agent/web

# Upload limits.
DRUM_AGENT_MAX_UPLOAD_MB=200
DRUM_AGENT_MAX_AUDIO_MINUTES=20

# Optional: recordings the operator is authorized to transcribe, with a manifest
# assets.json = [{"file": "song.flac", "title": "...", "artist": "...", "rights": "licensed"}]
# rights: own | permission | licensed | public_domain | original
DRUM_AGENT_ASSET_DIR=

# Song search. MusicBrainz, iTunes and Deezer need no keys (set to 0 to turn them off).
DRUM_AGENT_PUBLIC_METADATA=1
DRUM_AGENT_PROVIDER_TIMEOUT=8
# Spotify Web API, client-credentials flow: metadata only (no audio, no previews).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3: metadata only (the server never downloads YouTube audio).
YOUTUBE_API_KEY=

# Claude: suggests section names for a chart (optional).
ANTHROPIC_API_KEY=
# A current Claude model id: https://docs.anthropic.com/en/docs/about-claude/models
DRUM_AGENT_ANTHROPIC_MODEL=
# Leave empty for the public API.
DRUM_AGENT_ANTHROPIC_BASE_URL=

# Drum separation (HTDemucs, when PyTorch and demucs are installed): CPU threads, 0 = PyTorch's choice.
DRUM_AGENT_TORCH_THREADS=0

# Personal app only (`serve --personal`, the desktop app; never a shared server): folders
# searched for a typed song besides ~/Music, separated like PATH.
DRUM_AGENT_MUSIC_DIRS=

# LilyPond, when it isn't in /opt/lilypond-2.26.0 or on PATH.
DRUM_AGENT_LILYPOND=
DRUM_AGENT_LOG_LEVEL=INFO
